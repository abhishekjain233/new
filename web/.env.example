# Public base URL of the Fetch backend (no trailing slash). Leave blank during
# local development if you proxy /api through Vite's dev server, or to use the
# same origin in production. Examples:
#   VITE_API_BASE_URL=http://localhost:3000
#   VITE_API_BASE_URL=https://fetch-backend.up.railway.app
VITE_API_BASE_URL=http://localhost:3000
