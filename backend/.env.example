PORT=3000
REDIS_URL=redis://localhost:6379
# Path to yt-dlp. "yt-dlp" resolves via $PATH; on Railway nixpacks installs it for you.
YTDLP_PATH=yt-dlp
TEMP_DIR=/tmp
FILE_TTL_MINUTES=10
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
MAX_CONCURRENT_DOWNLOADS=5
PROGRESS_KEY_TTL_SECONDS=900
LOG_LEVEL=info

# Optional. Netscape-format cookies.txt, base64-encoded.
# Required to bypass YouTube's "Sign in to confirm you're not a bot" wall on
# datacenter IPs (Railway, Fly, Render, ...) and to access Instagram/Snapchat
# content that requires a logged-in session.
#
# How to set: install the "Get cookies.txt LOCALLY" browser extension, log
# into youtube.com (and instagram.com if needed), export cookies.txt, then:
#   base64 -w0 cookies.txt
# Paste the resulting string as the value below.
YTDLP_COOKIES_B64=
